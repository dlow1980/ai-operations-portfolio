{
    "name": "Integration Google Drive",
    "flow": [
        {
            "id": 1,
            "module": "google-drive:watchFilesInAFolder",
            "version": 4,
            "parameters": {
                "limit": 2,
                "select": "create",
                "folderId": "/YOUR_FOLDER_ID",
                "mimeType": "all",
                "__IMTCONN__": null,
                "destination": "drive"
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 150
                },
                "setupValidation": {
                    "result": {
                        "valid": true,
                        "fields": []
                    },
                    "version": 1,
                    "configuration": "sanitized_configuration"
                },
                "restore": {
                    "parameters": {
                        "select": {
                            "label": "By Created Time"
                        },
                        "folderId": {
                            "path": [
                                "Incoming_Invoices"
                            ]
                        },
                        "mimeType": {
                            "label": "All"
                        },
                        "__IMTCONN__": {
                            "data": {
                                "scoped": "true",
                                "connection": "google-drive"
                            },
                            "label": "My Google Connection"
                        },
                        "destination": {
                            "label": "My Drive"
                        }
                    }
                }
            }
        },
        {
            "id": 2,
            "module": "google-drive:getAFile",
            "version": 4,
            "parameters": {
                "__IMTCONN__": null
            },
            "mapper": {
                "file": "{{1.id}}",
                "select": "map",
                "formatDrawings": "image/jpeg",
                "formatDocuments": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                "formatSpreadsheets": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                "formatPresentations": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 150
                },
                "setupValidation": {
                    "result": {
                        "valid": true,
                        "fields": []
                    },
                    "version": 1,
                    "configuration": "sanitized_configuration"
                },
                "restore": {
                    "parameters": {
                        "__IMTCONN__": {
                            "data": {
                                "scoped": "true",
                                "connection": "google-drive"
                            },
                            "label": "My Google Connection"
                        }
                    }
                }
            }
        },
        {
            "id": 4,
            "module": "gemini-ai:createACompletionGeminiPro",
            "version": 1,
            "parameters": {
                "__IMTCONN__": null
            },
            "mapper": {
                "model": "gemini-3.5-flash-lite",
                "contents": [
                    {
                        "role": "user",
                        "parts": [
                            {
                                "text": "Extract the following fields from the attached invoice document into a single JSON object:\r\n- invoice_id (string: the invoice number or reference code)\r\n- vendor_name (string: name of the issuing company or vendor)\r\n- invoice_date (string: MM-DD-YYYY format)\r\n- total_amount (number: total numerical amount due, without currency symbols)",
                                "type": "text"
                            },
                            {
                                "type": "file",
                                "file_data": {
                                    "file_uri": "{{2.webContentLink}}",
                                    "mime_type": "application/pdf"
                                }
                            }
                        ]
                    }
                ],
                "generationConfig": {
                    "imageConfig": {},
                    "thinkingConfig": {}
                },
                "system_instruction": {
                    "parts": [
                        {
                            "text": "You are an invoice data extraction engine. Extract key financial details from documents accurately. You must strictly output valid, raw JSON only. Do not include markdown code block formatting (never wrap in ```json or ```). Do not include any explanations or introductory text."
                        }
                    ]
                }
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 150
                },
                "restore": {
                    "parameters": {
                        "__IMTCONN__": {
                            "data": {
                                "scoped": "true",
                                "connection": "gemini-ai"
                            },
                            "label": "Google Gemini AI Connection"
                        }
                    }
                }
            }
        },
        {
            "id": 5,
            "module": "json:ParseJSON",
            "version": 1,
            "parameters": {
                "type": 587257
            },
            "mapper": {
                "json": "{{4.candidates[].content.parts[].text}}"
            },
            "metadata": {
                "designer": {
                    "x": 900,
                    "y": 150
                }
            }
        },
        {
            "id": 10,
            "module": "builtin:BasicRouter",
            "version": 1,
            "mapper": null,
            "metadata": {
                "designer": {
                    "x": 1200,
                    "y": 150
                }
            },
            "routes": [
                {
                    "flow": [
                        {
                            "id": 13,
                            "module": "google-sheets:addRow",
                            "version": 2,
                            "parameters": {
                                "__IMTCONN__": null
                            },
                            "filter": {
                                "name": "Branch A (Auto-Approve)",
                                "conditions": [
                                    [
                                        {
                                            "a": "{{5.total_amount}}",
                                            "b": "1000.00",
                                            "o": "number:less"
                                        }
                                    ]
                                ]
                            },
                            "mapper": {
                                "from": "drive",
                                "mode": "select",
                                "values": {
                                    "0": "{{5.invoice_id}}",
                                    "1": "{{5.vendor_name}}",
                                    "2": "{{5.invoice_date}}",
                                    "3": "{{5.total_amount}}",
                                    "4": "Auto-Approved",
                                    "5": "{{2.webContentLink}}",
                                    "6": "{{formatDate(now; \"DD-MM-YYYY HH:mm \"; \" Asia/Singapore\")}}"
                                },
                                "sheetId": "Sheet1",
                                "spreadsheetId": "/YOUR_FOLDER_ID/YOUR_SPREADSHEET_ID",
                                "includesHeaders": true,
                                "insertDataOption": "INSERT_ROWS",
                                "useColumnHeaders": false,
                                "valueInputOption": "USER_ENTERED",
                                "insertUnformatted": false
                            },
                            "metadata": {
                                "designer": {
                                    "x": 1500,
                                    "y": 0
                                }
                            }
                        }
                    ]
                },
                {
                    "flow": [
                        {
                            "id": 14,
                            "module": "google-sheets:addRow",
                            "version": 2,
                            "parameters": {
                                "__IMTCONN__": null
                            },
                            "filter": {
                                "name": "Branch B (Approval Required / HITL)",
                                "conditions": [
                                    [
                                        {
                                            "a": "{{5.total_amount}}",
                                            "b": "1000.00",
                                            "o": "number:greaterorequal"
                                        }
                                    ]
                                ]
                            },
                            "mapper": {
                                "from": "drive",
                                "mode": "select",
                                "values": {
                                    "Status": "Pending Review",
                                    "File Link": "{{2.webContentLink}}",
                                    "Invoice ID": "{{5.invoice_id}}",
                                    "Vendor Name": "{{5.vendor_name}}",
                                    "Invoice Date": "{{5.invoice_date}}",
                                    "Processed At": "{{formatDate(now; \"DD-MM-YYYY HH:mm \"; \" Asia/Singapore\")}}",
                                    "Total Amount": "{{5.total_amount}}"
                                },
                                "sheetId": "Sheet1",
                                "spreadsheetId": "/YOUR_FOLDER_ID/YOUR_SPREADSHEET_ID",
                                "includesHeaders": true,
                                "insertDataOption": "INSERT_ROWS",
                                "useColumnHeaders": true,
                                "valueInputOption": "USER_ENTERED",
                                "insertUnformatted": false
                            },
                            "metadata": {
                                "designer": {
                                    "x": 1500,
                                    "y": 300
                                }
                            }
                        },
                        {
                            "id": 15,
                            "module": "google-email:sendAnEmail",
                            "version": 4,
                            "parameters": {
                                "__IMTCONN__": null
                            },
                            "mapper": {
                                "to": [
                                    "purchaser_or_approver@example.com"
                                ],
                                "content": "\"https://www.appsheet.com/start/YOUR-APPSHEET-APP-ID#view=Invoice_Master_Database\"",
                                "subject": "invoices approval",
                                "bodyType": "rawHtml",
                                "attachments": [
                                    {
                                        "data": "{{2.data}}",
                                        "filename": "{{2.name}}"
                                    }
                                ]
                            },
                            "metadata": {
                                "designer": {
                                    "x": 1800,
                                    "y": 300
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "metadata": {
        "instant": false,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "eu1.make.com",
        "notes": []
    }
}
